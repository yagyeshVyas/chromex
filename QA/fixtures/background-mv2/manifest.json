{
  "manifest_version": 2,
  "name": "Legacy Background",
  "version": "1.0.0",
  "description": "CHROMEX QA fixture",
  "permissions": [
    "storage",
    "https://example.com/*"
  ],
  "background": {
    "scripts": [
      "bg.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html"
  }
}
